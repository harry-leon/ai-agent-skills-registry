# SkillVault Environment Configuration Template
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillvault?schema=public

# Better Auth Secret (Must be >= 32 characters)
BETTER_AUTH_SECRET=skillvault_development_secret_must_be_at_least_32_characters_long

# Storage Configuration ('local' for dev only, 's3' for production/MinIO/R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/blobs

# S3 / MinIO Settings (Required when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skillvault-blobs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SkillVault <no-reply@skillvault.local>
REQUIRE_EMAIL_VERIFICATION=false

# Security & Proxy
TRUSTED_PROXY_HEADER=
LOG_LEVEL=info

# Ingestion & Upload Limits
MAX_FILE_BYTES=10485760
MAX_SKILL_TOTAL_BYTES=52428800
MAX_SKILL_FILES=500
MAX_ZIP_COMPRESSED_BYTES=52428800
MAX_ZIP_UNCOMPRESSED_BYTES=209715200
MAX_ZIP_COMPRESSION_RATIO=100
MAX_ZIP_ENTRIES=5000
MAX_PATH_DEPTH=10
MAX_PATH_LENGTH=255
GITHUB_IMPORT_MAX_BYTES=104857600

# Optional Integrations
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
